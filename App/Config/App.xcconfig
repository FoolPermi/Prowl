ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
AUTOMATION_APPLE_EVENTS = YES
CODE_SIGN_STYLE = Automatic
COMBINE_HIDPI_IMAGES = YES
DEAD_CODE_STRIPPING = YES
DEVELOPMENT_TEAM =
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_PREVIEWS = YES
ENABLE_RESOURCE_ACCESS_AUDIO_INPUT = YES
ENABLE_RESOURCE_ACCESS_CALENDARS = YES
ENABLE_RESOURCE_ACCESS_CAMERA = YES
ENABLE_RESOURCE_ACCESS_CONTACTS = YES
ENABLE_RESOURCE_ACCESS_LOCATION = YES
ENABLE_RESOURCE_ACCESS_PHOTO_LIBRARY = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
EXECUTABLE_NAME = ProwlApp
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
MACOSX_DEPLOYMENT_TARGET = 15.0
// FoundationModels only exists in the macOS 26 SDK while the app deploys to macOS 15.
// Weak-link it under the SDKs that have it, so a binary built there still launches on
// macOS 15, and keep Swift from autolinking the framework strongly in the same build.
// SDK conditions cover every 20-and-later SDK; older SDKs do not have the framework and
// must not receive the flag, which would fail at link time.
PROWL_WEAK_FRAMEWORKS[sdk=macosx2*] = -weak_framework FoundationModels
OTHER_LDFLAGS = $(inherited) -lc++ -framework GameController $(PROWL_WEAK_FRAMEWORKS)
OTHER_SWIFT_FLAGS = $(inherited) -Xcc -Wno-incomplete-umbrella -Xfrontend -disable-autolink-framework -Xfrontend FoundationModels
PRODUCT_MODULE_NAME = Prowl
// Liquid Glass, ToolbarSpacer, sharedBackgroundVisibility, and toolbar(removing:) exist only in
// the macOS 26 SDK. Source cannot test the SDK version directly, and a compiler check would be
// wrong (a Swift 6.2 compiler also builds against the macOS 15 SDK), so the SDK that is
// actually selected defines the condition that Support/LiquidGlassSupport.swift reads.
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=macosx2*] = $(inherited) PROWL_LIQUID_GLASS
REGISTER_APP_GROUPS = YES
RUNTIME_EXCEPTION_ALLOW_DYLD_ENVIRONMENT_VARIABLES = NO
RUNTIME_EXCEPTION_ALLOW_JIT = NO
RUNTIME_EXCEPTION_ALLOW_UNSIGNED_EXECUTABLE_MEMORY = NO
RUNTIME_EXCEPTION_DEBUGGING_TOOL = NO
RUNTIME_EXCEPTION_DISABLE_EXECUTABLE_PAGE_PROTECTION = NO
RUNTIME_EXCEPTION_DISABLE_LIBRARY_VALIDATION = NO
STRING_CATALOG_GENERATE_SYMBOLS = YES
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_VERSION = 6.0
